{
  "name": "functional-acceptance-test-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Postboard: a tiny web app showing functional tests over the API and acceptance tests over the UI",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev:server": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "node --test \"test/unit/**/*.test.ts\" \"test/functional/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:functional": "node --test \"test/functional/**/*.test.ts\"",
    "test:build": "node --test \"test/build/**/*.test.ts\"",
    "test:acceptance": "bddgen && playwright test",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.11",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "playwright-bdd": "9.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "yaml": "2.9.1"
  }
}
